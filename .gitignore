# Whitelist. Only original source, docs and build files are tracked.
#
# This repository contains NO Blizzard content: no art, models, sounds, maps,
# textures, locale data, extracted tables or decompiled code. Everything under
# /dev and everything the tools extract stays on the machine that extracted it.
# Overwatch is read from the user's own install at runtime and is never
# redistributed. See CREDITS.md.

/*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/README.md
!/CREDITS.md
!/CONTRIBUTING.md
!/AGENTS.md
!/STATUS-handoff.md
!/MODLOG.md
!/LICENSE-MIT
!/LICENSE-APACHE
!/rust-toolchain.toml
!/.gitattributes
!/.cargo/
!/.cargo/config.toml
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/crates/
!/docs/
!/dev/

# The analysis tools are original work and are tracked, so a re-derivation
# survives a lost machine. Everything they *produce* is not: captures,
# merged images, decompiles, hex dumps and the multi-MB text outputs stay on
# the machine that made them (dev/data/corpus, gitignored).
/dev/*
!/dev/*.py
!/dev/*.ps1
!/dev/*.md
!/dev/*.txt
!/dev/*.jsonl

# dev/'s sub-folders are ignored, except dev/verify_harness/ (the
# differential-verification harness, original work). dev/ghidra_run/ is the
# Ghidra project: the client's own code, kept on the SSD because Ghidra reads
# it hard, never tracked. dev/decompiles/ holds decompiled client code and
# stays ignored.
/dev/*/
!/dev/verify_harness/
/dev/verify_harness/*
!/dev/verify_harness/*.py
!/dev/verify_harness/*.h
!/dev/verify_harness/*.rs
!/dev/verify_harness/*.md
!/dev/verify_harness/units/
/dev/verify_harness/units/*
!/dev/verify_harness/units/*.json
/target/
**/target/

# Never track anything that came out of the game.
*.cmf
*.trg
*.apm
*.idx
*.index
*.blte
*.stu
*.keyring
*.00c
*.0bc
*.npy
*.raw
*.bin

# Nor extracted or derived data.
/extracted/
/out/
/artifacts/
**/tests/fixtures/
